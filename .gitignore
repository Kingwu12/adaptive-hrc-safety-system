# Local dashboard authorization secret — never commit
data/xsens/.control_key
data/xsens/.form_completion_url
data/xsens/dashboard.log
data/xsens/*.catalog.json

# Local participant captures and backup packages — store in the research Drive,
# never in the source repository. Previously committed synthetic/pilot fixtures
# remain tracked, but new session files are ignored.
data/xsens/P*-T*-20*.jsonl
data/xsens/P*-T*-20*.manifest.json
exports/
outputs/

# LaTeX build artifacts
paper/*.pdf
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# OS / editor
.DS_Store
.idea/
.vscode/
sim/ursim/docker-compose.local.yml
dashboard/tsconfig.tsbuildinfo

# Dashboard runtime logs (stdout/stderr captures — regenerated on every run, never source)
/logs/
data/service-logs/
